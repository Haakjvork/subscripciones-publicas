---
import SiteLink from "../ui/SiteLink.astro";
---

<footer>
	<p class="footer-copy">Herramienta para estimar impuestos sobre tu salario. Los valores son orientativos.</p>
	<nav class="footer-links" aria-label="Enlaces de pie">
		<SiteLink href="/about" variant="secondary">Acerca de</SiteLink>
	</nav>
</footer>

<style>
	footer {
		border: 1px solid var(--line);
		border-radius: 12px;
		background: var(--bg-soft);
		margin-top: 2rem;
		padding: 1.5rem;
		font-size: 0.875rem;
		color: var(--ink-soft);
		box-shadow: var(--shadow);
	}

	.footer-copy {
		margin: 0;
	}

	.footer-links {
		margin-top: 0.75rem;
		display: flex;
		gap: 0.75rem;
	}
</style>
